    def get_bar_ohlc_data(self, source="close"):
        """Return each bar's OHLC rounded to box levels, plus its PnF level.
    
        ``level`` is the box level of ``source`` for that bar.
        """
        b = self.box_size
        rows = []
        for date, row in zip(self._dates(), self.df.itertuples(index=False)):
            rows.append({
                "date": date,
                "open": self.roundit(row.open, b),
                "high": self.roundit(row.high, b),
                "low": self.roundit(row.low, b),
                "close": self.roundit(row.close, b),
>               "level": self.roundit(getattr(row, source), b),
                                      ^^^^^^^^^^^^^^^^^^^^
            })
