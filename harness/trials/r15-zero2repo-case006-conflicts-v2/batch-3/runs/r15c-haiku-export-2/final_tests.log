        print(
            f"True={case_true.stdout_text!r} OFF={case_off.stdout_text!r}",
            flush=True,
        )
        assert_success_marker_present(case_true, greeting)
        assert "BOOL:YES" in _type_stdout(case_true)
        assert_success_marker_present(case_off, greeting)
