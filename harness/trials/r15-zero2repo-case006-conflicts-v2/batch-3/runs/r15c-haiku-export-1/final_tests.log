        a_opt_l = f"AO:{_word()}:"
        a_arg_l = f"AA:{_word()}:"
        b_opt_l = f"BO:{_word()}:"
        b_arg_l = f"BA:{_word()}:"
        assert len({v1, v2, arg1, arg2}) == 4
    
        @_name_callback
        def a_cb(**kwargs: Any) -> None:
            print(a_hi, flush=True)
            print(f"{a_opt_l}{kwargs[opt_dest]}", flush=True)
