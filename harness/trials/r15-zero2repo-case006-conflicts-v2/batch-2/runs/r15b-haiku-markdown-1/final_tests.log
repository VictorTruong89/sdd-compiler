            data = kwargs[dest].read()
            print(f"KIND:{type(data).__name__}", flush=True)
            print(f"MARK:{_payload_mark(data, salt)}", flush=True)
    
        write_cb.__name__ = f"{_word()}_{_word()}"
        read_cb.__name__ = f"{_word()}_{_word()}"
