        assert marker_occurs(_stdout(mapped), f"T:{number * 3 + 7}")
        assert labeled_stdout_field(mapped, "XSRC:") == "NO_TRACKED_SOURCE"
        assert labeled_stdout_field(mapped, "SRC:") != labeled_stdout_field(mapped, "XSRC:")
    
