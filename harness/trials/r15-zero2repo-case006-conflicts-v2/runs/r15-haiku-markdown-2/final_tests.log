            echo(style(payload, fg="green"))
            echo(plain)
    
        cli = _cmd(callback)
        runner = CliRunner()
        omitted = runner.invoke(cli, [])
        forced = runner.invoke(cli, [], color=True)
        _observe("color-omitted", omitted)
        _observe("color-on", forced)
