                print(greeting, flush=True)
                print(mark if kwargs[dest] == secret else "K:0", flush=True)
                print(f"SALT:{salt}", flush=True)
    
            return _cmd(
                callback, option(flag, dest, prompt=ask, hide_input=hidden)
