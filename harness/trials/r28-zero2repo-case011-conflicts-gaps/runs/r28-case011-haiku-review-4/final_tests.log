    def test_compile_path_function_failures():
        twelve = with_sentinel(_twelve())
        people = with_sentinel(_age_people())
        unknown, arity, typed = _representatives(twelve)
        compile_unknown = require_unsuccessful_compile_path(UNKNOWN_EXPR, twelve)
        compile_arity = require_unsuccessful_compile_path(ARITY_EXPR, twelve)
        compile_typed = require_unsuccessful_compile_path(TYPE_EXPR, twelve)
        assert_shares_function_kind(compile_unknown, unknown)
        assert_shares_function_kind(compile_arity, arity)
        assert_shares_function_kind(compile_typed, typed)
        assert_three_function_kind_markers_distinct(
            compile_unknown, compile_arity, compile_typed
        )
        compile_sort_arity = require_unsuccessful_compile_path("sort_by(people)", people)
        compile_sort_typed = require_unsuccessful_compile_path(
            "sort_by(people, name)", people
        )
        assert_shares_function_kind(compile_sort_arity, arity)
        assert_does_not_use_function_kind(compile_sort_arity, unknown)
        assert_does_not_use_function_kind(compile_sort_arity, typed)
        assert_shares_function_kind(compile_sort_typed, typed)
        assert_does_not_use_function_kind(compile_sort_typed, unknown)
        assert_does_not_use_function_kind(compile_sort_typed, arity)
        compile_quoted = assert_bracket_compile_is_value_error(QUOTED_EXPR)
        compile_empty = assert_bracket_compile_is_value_error("")
        compile_incomplete = assert_bracket_compile_is_value_error("(")
