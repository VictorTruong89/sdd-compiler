        cli.add_command(
            _cmd(
                b_cb,
                option(opt_flag, opt_dest),
                argument(arg_dest),
                name=b_name,
            )
        )
    
        legal = _dispatch(
            cli,
            [a_name, opt_flag, v1, arg1, b_name, opt_flag, v2, arg2],
