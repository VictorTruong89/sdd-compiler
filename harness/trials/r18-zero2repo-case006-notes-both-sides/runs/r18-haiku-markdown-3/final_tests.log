    def test_parameter_completer_sees_context_parameter_and_incomplete_token():
        greeting = _greeting()
        exe = _exe()
        mark = f"MK{uuid.uuid4().hex}"
        ctx_flag = f"--n{_word()}"
        ctx_dest = _word()
        flag_a = f"--a{_word()}"
        flag_b = f"--b{_word()}"
