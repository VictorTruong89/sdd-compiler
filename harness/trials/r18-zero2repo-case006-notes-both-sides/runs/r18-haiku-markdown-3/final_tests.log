    def test_pause_does_nothing_when_not_interactive():
        greeting = _greeting()
    
        def paused() -> None:
            print(greeting, flush=True)
            pause()
    
        def untouched() -> None:
            print(greeting, flush=True)
    
        paused_result = require_completed_within(
            lambda: _dispatch(_cmd(paused), []),
