    def test_zsh_and_fish_include_author_help_next_to_value():
        greeting = _greeting()
        exe = _exe()
        flag = f"--v{_word()}"
        dest = _word()
        val_a = f"va{_word()}"
        val_b = f"vb{_word()}"
