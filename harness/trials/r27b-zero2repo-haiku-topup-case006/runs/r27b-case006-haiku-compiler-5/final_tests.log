        @_name_callback
        def b_cb(**kwargs: Any) -> None:
            print(b_hi, flush=True)
            print(f"{b_opt_l}{kwargs[opt_dest]}", flush=True)
            print(f"{b_arg_l}{kwargs[arg_dest]}", flush=True)
    
