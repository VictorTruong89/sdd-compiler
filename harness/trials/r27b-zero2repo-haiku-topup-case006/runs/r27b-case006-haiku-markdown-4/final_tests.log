        assert "BOOL:YES" in _type_stdout(case_true)
        assert_success_marker_present(case_off, greeting)
        assert "BOOL:NO" in _type_stdout(case_off)
    
        unknown = unrelated_dispatch_token(*_BOOL_ON, *_BOOL_OFF)
