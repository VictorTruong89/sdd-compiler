    def invoke(self, cli, args=None, input=None, env=None, catch_exceptions=None, color=False, **extra):
        """Run ``cli`` with ``args`` and return a :class:`Result`."""
        if catch_exceptions is None:
            catch_exceptions = self.catch_exceptions
        if isinstance(args, str):
            args = args.split()
        args = list(args or [])
        prog_name = extra.pop("prog_name", "cli")
        standalone = extra.pop("standalone_mode", True)
        extra.setdefault("color", color)
    
        exit_code = 0
        exception = None
        return_value = None
        with self.isolation(input=input, env=env, color=color) as (out_buf, err_buf, combined, stdout, stderr):
            try:
                return_value = cli.main(
                    args=args,
                    prog_name=prog_name,
                    standalone_mode=standalone,
                    **extra,
                )
            except SystemExit as e:
                exit_code = e.code if isinstance(e.code, int) else (0 if e.code is None else 1)
            except Exception as e:  # noqa: BLE001 - reported on the result
                if not catch_exceptions:
                    raise
                exception = e
                exit_code = 1
            stdout.flush()
            stderr.flush()
            if self.capture != "fd":
                stdout_bytes = out_buf.getvalue()
                stderr_bytes = err_buf.getvalue()
                output_text = "".join(combined)
        # Descriptor capture is only complete once the isolation block has restored them.
        if self.capture == "fd":
            out_text, err_text = getattr(self, "_fd_result", ("", ""))
