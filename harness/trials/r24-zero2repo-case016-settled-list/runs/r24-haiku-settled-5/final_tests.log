        require_finding(gq_f, 48)
        require_finding(url_f, 65)
        gq_score = score_of(gq_m, findings=gq_f)
        url_score = score_of(url_m, findings=url_f)
        gq_conf = confidence_of(gq_m)
        url_conf = confidence_of(url_m)
