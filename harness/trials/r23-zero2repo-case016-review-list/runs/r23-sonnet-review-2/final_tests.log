    def test_file_with_crlf_still_has_crlf_after_cleanup():
        w1 = "Oak" + secrets.token_hex(2)
        w2 = "pine" + secrets.token_hex(2)
        lf_text = f"{w1}{ZWSP} sits {w2}.\n"
        crlf_text = lf_text.replace("\n", "\r\n")
        with workspace() as ws:
