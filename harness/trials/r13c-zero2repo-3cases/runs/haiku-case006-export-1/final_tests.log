            else:
                print(f"SRC:{src}", flush=True)
            extra_src = ctx.get_parameter_source(extra)
            if extra_src is None:
                print("XSRC:NO_TRACKED_SOURCE", flush=True)
            else:
                print(f"XSRC:{extra_src}", flush=True)
            stuffed = kwargs.get(extra, "MISSING")
