                print(f"SALT:{salt}", flush=True)
    
            return _cmd(callback, option(flag, dest, prompt=ask, hide_input=hidden))
    
        runner = CliRunner()
        visible = runner.invoke(make(hidden=False), [], input=f"{secret}\n")
