            )
            _, missing = _detector_failure(
                ws, {"stdout": without_score, "exit_code": 0}, timeout=20
            )
            _, timed = _detector_failure(
                ws, {"sleep_s": 30, "forward": True}, timeout=20
            )
            missing_path = fresh_name(".md")
            miss_sid = _sid()
