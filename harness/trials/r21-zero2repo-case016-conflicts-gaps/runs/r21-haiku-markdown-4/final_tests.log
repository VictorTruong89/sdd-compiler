    def test_other_extensions_are_not_scored_or_handed_to_the_detector():
        dense = prose_dense()
        other = secrets.choice([".csv", ".log", ".html", ".xml", ".yaml"])
        assert other not in _TWENTY and other not in {".py", ".js"}
