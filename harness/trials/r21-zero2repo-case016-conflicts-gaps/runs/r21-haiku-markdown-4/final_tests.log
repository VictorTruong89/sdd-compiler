                ws, ordinary_prompt(), env_updates={ENV_DEFAULT_MODE: "lite"}
            )
            sub_r = subagent_start(ws, env_updates={ENV_DEFAULT_MODE: "lite"})
            wrapped = subagent_contract(sub_r)
