        for field in fields:
            sep = field.find(":")
            if sep < 0:
                raise AssertionError(
                    f"malformed extra-argument record {field!r}; "
                    f"stdout={getattr(result, 'stdout_text', result)!r}"
                )
            members.append(field[sep + 1 :])
