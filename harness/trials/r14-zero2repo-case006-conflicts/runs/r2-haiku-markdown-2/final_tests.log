                "from optlyn import echo_via_pager\n"
                f"A = {first!r}\n"
                f"B = {second!r}\n"
                "def chunks():\n"
                "    yield A\n"
                "    deadline = time.monotonic() + 8\n"
                "    while time.monotonic() < deadline:\n"
                "        try:\n"
                "            data = open(SENTINEL, 'rb').read()\n"
                "        except OSError:\n"
                "            data = b''\n"
                "        if A.encode('utf-8') in data:\n"
                "            break\n"
                "        time.sleep(0.05)\n"
                "    else:\n"
