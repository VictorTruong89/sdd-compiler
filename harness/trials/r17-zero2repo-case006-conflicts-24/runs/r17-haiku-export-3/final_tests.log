            "bash",
            completed=(ctx_flag, str(count_left), flag_a),
            incomplete=token_y,
        )
        at_a_empty = _complete(
            cli,
            exe,
            "bash",
            completed=(ctx_flag, str(count_left), flag_a),
            incomplete="",
        )
        at_b = _complete(
            cli,
            exe,
            "bash",
            completed=(ctx_flag, str(count_left), flag_b),
            incomplete=token_x,
        )
        print(
            f"a_left={at_a_left.stdout_text!r} a_ctx={at_a_right_ctx.stdout_text!r} "
