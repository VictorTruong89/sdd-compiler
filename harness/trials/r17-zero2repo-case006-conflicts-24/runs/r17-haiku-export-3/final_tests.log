        )
        at_a_left = _complete(
            cli,
            exe,
            "bash",
            completed=(ctx_flag, str(count_left), flag_a),
            incomplete=token_x,
        )
        at_a_right_ctx = _complete(
            cli,
            exe,
            "bash",
            completed=(ctx_flag, str(count_right), flag_a),
            incomplete=token_x,
